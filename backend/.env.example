# ─────────────────────────────────────────────────────────────
# BidHouse — backend
#
# Copia este archivo y rellena los valores reales:
#   cp .env.example .env
#
# El .env NUNCA se sube al repo. Los valores salen del panel de
# Supabase: Project Settings → API.
#
# Ojo: DotenvEnvironmentPostProcessor lee el .env relativo al
# directorio desde donde arrancas la app. Levanta el backend
# desde backend/, no desde la raiz del repo, o no lo encuentra.
# ─────────────────────────────────────────────────────────────

# URL del proyecto de Supabase.
# Es el mismo valor que VITE_SUPABASE_URL en frontend/.env
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Llave publica (antes se llamaba "anon key").
# Es el mismo valor que VITE_SUPABASE_ANON_KEY en frontend/.env
SUPABASE_PUBLISHABLE_KEY=

# ⚠️  LLAVE SECRETA (service_role). Se salta TODAS las politicas RLS.
# Solo vive aqui, en el backend. Nunca en el frontend, nunca en el
# navegador, nunca en un chat ni en un commit. Si se filtra, rotala
# de inmediato desde el panel de Supabase.
SUPABASE_SECRET_KEY=

# Endpoint de llaves publicas para validar los JWT que emite Supabase.
SUPABASE_JWKS_URL=https://TU-PROYECTO.supabase.co/auth/v1/.well-known/jwks.json

# ⚠️  Access Token de Mercado Pago (credenciales de PRUEBA, sandbox).
# Es secreto: con él se puede cobrar y reembolsar. Solo vive aquí, en el
# backend. La Public Key no hace falta con Checkout Pro (el comprador paga
# en la página de Mercado Pago).
# Sale de: Mercado Pago Developers → Tus integraciones → Credenciales de prueba.
MERCADOPAGO_ACCESS_TOKEN=

# ─── Blockchain (Sepolia, red de PRUEBAS) ───
# Los llenan los scripts de blockchain/: "bun run billetera" crea la billetera
# y "bun run desplegar" el contrato. Solo UN backend del equipo debe tenerlos:
# dos backends firmando con la misma billetera chocan.
# ⚠️  La llave privada es secreta y la billetera NUNCA debe tener dinero real.
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_CONTRACT_ADDRESS=
