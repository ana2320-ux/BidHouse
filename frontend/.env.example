# ─────────────────────────────────────────────────────────────
# BidHouse — frontend
#
# Copia este archivo y rellena los valores reales:
#   cp .env.example .env
#
# El .env NUNCA se sube al repo.
#
# ⚠️  Todo lo que lleve prefijo VITE_ queda COMPILADO dentro del
# bundle y es visible para cualquiera que abra la pagina. Aqui solo
# van valores publicos. Si una llave es secreta, va en backend/.env
# y se accede a traves del backend, nunca desde aqui.
#
# Vite solo expone las variables con prefijo VITE_: una variable
# sin ese prefijo simplemente no llega al codigo.
# ─────────────────────────────────────────────────────────────

# URL del proyecto de Supabase.
# Mismo valor que SUPABASE_URL en backend/.env
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Llave publica de Supabase (anon / publishable key).
# Es publica por diseno: lo que protege los datos son las politicas
# RLS del proyecto, no el secreto de esta llave.
# Mismo valor que SUPABASE_PUBLISHABLE_KEY en backend/.env
VITE_SUPABASE_ANON_KEY=
